<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="6dp"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <!-- Layout chứa ảnh sản phẩm và checkbox -->
        <FrameLayout
            android:layout_width="90dp"
            android:layout_height="90dp">

            <!-- Ảnh sản phẩm -->
            <ImageView
                android:id="@+id/item_giohang_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_media_24"/>

            <!-- CheckBox nằm trên ảnh -->
            <CheckBox
                android:id="@+id/item_giohang_check"
                android:layout_height="15dp"
                android:layout_width="15dp"
                android:layout_margin="4dp"/>
        </FrameLayout>

        <!-- Nội dung sản phẩm -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <!-- Tên sản phẩm -->
            <TextView
                android:id="@+id/item_giohang_tensp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tên sản phẩm"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#222222"
                android:maxLines="2"
                android:ellipsize="end"/>

            <!-- Giá sản phẩm -->
            <TextView
                android:id="@+id/item_giohang_gia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Giá: 500.000 VND"
                android:textSize="14sp"
                android:textColor="#FBB818"
                android:textStyle="bold"
                android:layout_marginTop="4dp"/>

            <!-- Điều chỉnh số lượng và tổng tiền -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <!-- Nút trừ -->
                <ImageView
                    android:id="@+id/item_giohang_tru"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:padding="6dp"
                    android:background="@drawable/round_button_bg"
                    android:src="@drawable/ic_baseline_remove_24" />

                <!-- Số lượng -->
                <TextView
                    android:id="@+id/item_giohang_soluong"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:text="1"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:textColor="#222222"/>

                <!-- Nút cộng -->
                <ImageView
                    android:id="@+id/item_giohang_cong"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:padding="6dp"
                    android:background="@drawable/round_button_bg"
                    android:src="@drawable/ic_baseline_add_24" />

                <!-- Dấu bằng -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" = "
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#222222"
                    android:layout_marginStart="12dp"/>

                <!-- Tổng tiền sản phẩm -->
                <TextView
                    android:id="@+id/item_giohang_giasp2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="500.000 VND"
                    android:textSize="16sp"
                    android:textColor="#E42222"
                    android:textStyle="bold"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
