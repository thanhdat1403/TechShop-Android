<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp">

        <!-- Ảnh sản phẩm -->
        <ImageView
            android:id="@+id/item_imagechitiet"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_baseline_person_24"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <!-- Tên sản phẩm -->
        <TextView
            android:id="@+id/item_tenspchitiet"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Điện thoại"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            app:layout_constraintStart_toEndOf="@id/item_imagechitiet"
            app:layout_constraintTop_toTopOf="@id/item_imagechitiet"
            app:layout_constraintEnd_toEndOf="parent"
            android:paddingStart="10dp"/>

        <!-- Giá sản phẩm -->
        <TextView
            android:id="@+id/item_giachitiet"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Giá: 500,000 VND"
            android:textSize="14sp"
            android:textColor="@android:color/holo_red_dark"
            app:layout_constraintStart_toEndOf="@id/item_imagechitiet"
            app:layout_constraintTop_toBottomOf="@id/item_tenspchitiet"
            app:layout_constraintEnd_toEndOf="parent"
            android:paddingStart="10dp"/>

        <!-- Số lượng sản phẩm -->
        <TextView
            android:id="@+id/item_soluongchitiet"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Số lượng: 2"
            android:textSize="14sp"
            android:textColor="@android:color/darker_gray"
            app:layout_constraintStart_toEndOf="@id/item_imagechitiet"
            app:layout_constraintTop_toBottomOf="@id/item_giachitiet"
            app:layout_constraintEnd_toEndOf="parent"
            android:paddingStart="10dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>
