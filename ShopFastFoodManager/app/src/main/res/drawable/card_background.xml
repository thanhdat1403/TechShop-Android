<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Bóng đổ -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp"/>  <!-- Bo góc -->
            <solid android:color="#22000000"/>  <!-- Màu bóng -->
        </shape>
    </item>

    <!-- Màu nền chính -->
    <item android:top="2dp" android:left="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp"/>  <!-- Bo góc -->
            <solid android:color="#FFFFFF"/>  <!-- Màu nền CardView -->
        </shape>
    </item>

</layer-list>
